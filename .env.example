# ──────────────────────────────────────────────────────────────────────────
# fox-trader — copy to `.env` and fill in. NEVER commit .env.
# Paper desk defaults. Real keys stay local only.
# ──────────────────────────────────────────────────────────────────────────

# ── Claude (optional; powers research, chat, bot reasoning, RAG) ───────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_EFFORT=high

# ── Robinhood Agentic MCP (optional; OAuth tokens stay gitignored) ─────────
RH_MCP_URL=https://agent.robinhood.com/mcp/trading
RH_TOKEN_STORE=./backend/data/oauth-tokens.json
RH_OAUTH_CALLBACK_PORT=7321

# ── MySQL ──────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=8889
DB_USER=root
DB_PASSWORD=
DB_NAME=rh_tradingbot

# ── Server ─────────────────────────────────────────────────────────────────
# Backend :8011; optional Apache proxy on :8888
PORT=8011
BASE_PATH=/grokbot/grokbot-rh-trader

# ── Trading safety (Fox · Trading desk defaults) ───────────────────────────
# observe | cautious | auto | full_auto
DEFAULT_MODE=full_auto
KILL_SWITCH=false
ALLOWED_ASSET_CLASSES=equity,etf,option

# Caps triad
MAX_POSITION_USD=10000
MAX_PORTFOLIO_CONCENTRATION_PCT=50
MAX_DAILY_LOSS_PCT=50
MAX_ORDERS_PER_DAY=40

# ── AI providers (optional) ────────────────────────────────────────────────
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=
LLM_POISON_PROVIDERS=
LOCAL_BASE_URL=
LOCAL_MODEL=
LOCAL_API_KEY=

# ── Alpaca paper (required for paper desk + market data) ───────────────────
# Keys: https://app.alpaca.markets -> Paper Trading -> API Keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets/v2
ALPACA_DATA_URL=https://data.alpaca.markets/v2
TRADING_ENV=alpaca_paper
